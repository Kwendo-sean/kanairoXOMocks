<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NOTE (P2-8): Universal link domains (applinks:kanairoxo.online and
  applinks:app.kanairoxo.online) require the Associated Domains capability,
  which is NOT available on a free Apple Developer Personal Team.

  To enable universal links on a paid account ($99/yr), add back:
    <key>com.apple.developer.associated-domains</key>
    <array>
      <string>applinks:kanairoxo.online</string>
      <string>applinks:app.kanairoxo.online</string>
    </array>

  The app-group below is kept — it powers the iOS home-screen widget
  and works on free accounts.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.kanairoxo.kanairoxo</string>
    </array>
</dict>
</plist>
