<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS Associated Domains entitlement for universal links.

  IMPORTANT: this file is not auto-attached to the Xcode project. After
  cloning, open ios/Runner.xcworkspace, select the Runner target →
  Signing & Capabilities → "+ Capability" → Associated Domains, then
  add the entries:
        applinks:kanairoxo.online
        applinks:app.kanairoxo.online

  Xcode will also auto-add this file (Runner.entitlements) to the
  Code Signing Entitlements build setting. After the first add, the
  capability persists across builds.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:kanairoxo.online</string>
        <string>applinks:app.kanairoxo.online</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.kanairoxo.kanairoxo</string>
    </array>
</dict>
</plist>
